# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://babalar:secret@localhost:5432/babalar

# ── AI APIs ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-CHANGE_ME

# ── Observability (optional — leave blank to disable Langfuse tracing) ────────
# Keys are found in Langfuse UI → Settings → API Keys.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# ── JEV decision layer (optional — leave blank to disable TypeSafe JEV) ───────
# Regex PII blocking still runs even when JEV is disabled.
TYPESAFE_API_KEY=
JEV_ENABLED=true
JEV_MODEL=jev-1.13.0
JEV_PII_BLOCK_THRESHOLD=0.70
JEV_OUT_OF_SCOPE_BLOCK_THRESHOLD=0.80
JEV_GROUNDING_BLOCK_THRESHOLD=0.35

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_32_CHAR_RANDOM_STRING
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30

# ── Internal ──────────────────────────────────────────────────────────────────
# The ingestion service authenticates to the backend with this key
INGEST_API_KEY=CHANGE_ME_RANDOM_HEX

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Ingestion Service ─────────────────────────────────────────────────────────
BACKEND_URL=http://backend:8000
INGEST_CRON=0 2 * * *
